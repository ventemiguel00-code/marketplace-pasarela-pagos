# Copiar como .env.supabase y completar solamente en el computador local.
# No reemplaza backend/.env, que sigue apuntando a PostgreSQL local.
SUPABASE_PGHOST=aws-0-us-west-2.pooler.supabase.com
SUPABASE_PGPORT=5432
SUPABASE_PGDATABASE=postgres
SUPABASE_PGUSER=postgres.cuxypsvgonawtjqvtzqx
SUPABASE_PGPASSWORD=escribir_solo_en_el_archivo_local

# Certificado descargado desde: Supabase > Database > Settings > SSL configuration.
SUPABASE_PGSSLROOTCERT=C:\ruta\segura\prod-ca-2021.crt
# En Render se puede usar el contenido PEM como secreto de entorno en lugar de una ruta.
# SUPABASE_PGSSLROOTCERT_CONTENT=-----BEGIN CERTIFICATE-----...\n-----END CERTIFICATE-----

# Se activan solamente cuando Login entregue el emisor, audiencia exacta y el contrato de Órdenes.
AUTH_JWT_REQUIRED=false
AUTH_JWT_ISSUER=https://xmrlazemifmepyahqsrz.supabase.co/auth/v1
AUTH_JWT_AUDIENCE=valor_entregado_por_login
AUTH_JWT_JWKS_URL=https://xmrlazemifmepyahqsrz.supabase.co/auth/v1/.well-known/jwks.json
