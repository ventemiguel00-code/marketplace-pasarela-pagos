# Express sirve también el frontend en http://localhost:3000
HOST=127.0.0.1
PORT=3000

# Conexión usada para verificar, guardar y consultar transacciones.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=marketplace_payments
PGUSER=postgres
PGPASSWORD=reemplazar_con_tu_clave_local

# Integración central. En local se conserva el modo académico si permanecen en false.
AUTH_JWT_REQUIRED=false
AUTH_JWT_ISSUER=https://xmrlazemifmepyahqsrz.supabase.co/auth/v1
AUTH_JWT_AUDIENCE=authenticated
AUTH_JWT_JWKS_URL=https://xmrlazemifmepyahqsrz.supabase.co/auth/v1/.well-known/jwks.json
# Configuración pública para que el navegador use el mismo Supabase Auth central.
AUTH_PUBLIC_URL=https://xmrlazemifmepyahqsrz.supabase.co
AUTH_PUBLIC_PUBLISHABLE_KEY=reemplazar_con_la_clave_publicable_central
ORDERS_INTEGRATION_ENABLED=false
ORDERS_BASE_URL=https://ordenes-thaliana.onrender.com

# Outbox durable. Activar solo después de aplicar la migración en el esquema elegido.
INTEGRATION_OUTBOX_ENABLED=false
# Las escrituras externas se habilitan únicamente con datos y autorización coordinados.
PAYMENT_INTEGRATIONS_WRITE_ENABLED=false
ORDERS_APPROVED_STATUS=CONFIRMADA
ACCOUNTING_BASE_URL=https://marketplace-usc-contabilidad.onrender.com
NOTIFICATIONS_BASE_URL=https://marketplace-usc-notificaciones.onrender.com
INVENTORY_BASE_URL=https://marketplace-equipo4.onrender.com
TRACKING_BASE_URL=https://marketplace-usc-seguimiento.onrender.com
INVENTORY_CONFIRMATION_BY_PAYMENTS=false
# Sin estado acordado, Pagos no actualiza Seguimiento.
TRACKING_PAYMENT_STATUS=
